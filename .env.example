# Modèle de configuration — copier en `.env` puis adapter :
#   cp .env.example .env
# Le fichier `.env` réel n'est jamais versionné (voir .gitignore).

# --- Base de données ---
# En local, l'URL pointe sur le service `db` de docker-compose.
DATABASE_URL=postgresql+asyncpg://tradetrack:tradetrack_password@localhost:5432/tradetrack
POSTGRES_PASSWORD=tradetrack_password

# --- Sécurité ---
# Générer une valeur unique :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=remplacer-par-une-valeur-generee
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis (optionnel) ---
# Sert uniquement au push temps réel des notifications. L'application démarre
# et fonctionne sans : seules les notifications instantanées passent en mode dégradé.
REDIS_URL=redis://localhost:6379

# --- CORS ---
# Origines autorisées à appeler l'API, séparées par des virgules, sans slash final.
# En production, y mettre l'URL du frontend déployé.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Règles métier ---
# Seuil d'alerte de stock bas sur les pièces détachées.
STOCK_ALERT_THRESHOLD=3

# --- Frontend ---
# URL de l'API vue par le navigateur. Vite inscrit cette valeur dans le build :
# en production, la renseigner sur l'hébergeur avant de construire le site.
VITE_API_URL=http://localhost:8000/api
